#!/Users/lariat/.pyenv/versions/3.12.3/bin/python3
"""Aggregate `pi` (AI coding assistant) token usage + cost by day.

Reads ~/.pi/agent/sessions/**/*.jsonl (one JSON object per line). Assistant
messages carry message.usage {input,output,cacheRead,cacheWrite,cost{...}} and
message.model. Subagent runs are also picked up from
sessions/**/subagent-artifacts/*_meta.json (timestamp taken from file mtime).

Usage:
  pi-usage                 full report for today (+ deltas vs prior days)
  pi-usage --oneline       compact single line for a status bar
  pi-usage --date 2026-08-27
  pi-usage --days 7        report the last N days instead of just today
  pi-usage --json          raw aggregate as JSON
  pi-usage --no-cache      bypass the 30s scan cache

Cost numbers use per-message cost when pi recorded it, otherwise they are
estimated from ~/.pi/agent/models-store.json pricing ($ per million tokens).
"""
from __future__ import annotations

import argparse
import datetime as dt
import glob
import json
import os
import sys
import time
from collections import defaultdict

PI_ROOT = os.path.expanduser("~/.pi/agent")
SESSIONS = os.path.join(PI_ROOT, "sessions")
MODELS_STORE = os.path.join(PI_ROOT, "models-store.json")
CACHE_PATH = os.path.join(
    os.environ.get("TMPDIR", "/tmp").rstrip("/"), "pi-usage-cache.json"
)
CACHE_TTL = 30  # seconds

TOKEN_KEYS = ("input", "output", "cacheRead", "cacheWrite")

# Providers whose usage is covered by a flat subscription rather than metered
# pay-per-token billing. Mirrors pi's built-in isSubscription providers
# (kimi-coding is subscription-backed even under api_key auth).
SUBSCRIPTION_PROVIDERS = frozenset(
    {"anthropic", "github-copilot", "kimi-coding", "openai-codex", "xai"}
)


def provider_of(model: str, explicit: str | None = None) -> str:
    if explicit:
        return explicit
    parts = model.split("/")
    return parts[0] if len(parts) > 1 else ""


def is_subscription(provider: str) -> bool:
    return provider in SUBSCRIPTION_PROVIDERS


# ---------------------------------------------------------------------------
# pricing
# ---------------------------------------------------------------------------
def load_pricing() -> dict[str, dict]:
    pricing: dict[str, dict] = {}
    try:
        store = json.load(open(MODELS_STORE))
    except Exception:
        return pricing
    for provider, blob in store.items():
        if not isinstance(blob, dict):
            continue
        for m in blob.get("models", []):
            cost = m.get("cost") or {}
            mid = m.get("id")
            if not mid:
                continue
            pricing[mid] = cost
            pricing[f"{provider}/{mid}"] = cost
    return pricing


def estimate_cost(model: str, u: dict, pricing: dict) -> float:
    c = pricing.get(model) or pricing.get(model.split("/")[-1]) or {}
    if not c:
        return 0.0
    total = 0.0
    for k in TOKEN_KEYS:
        total += (u.get(k, 0) or 0) * (c.get(k, 0) or 0)
    return total / 1_000_000


# ---------------------------------------------------------------------------
# scan
# ---------------------------------------------------------------------------
def _local_day(ts) -> str | None:
    if isinstance(ts, (int, float)) or (isinstance(ts, str) and ts.isdigit()):
        n = float(ts)
        if n > 1e11:  # milliseconds
            n /= 1000.0
        try:
            return dt.datetime.fromtimestamp(n, dt.timezone.utc).astimezone().date().isoformat()
        except (OSError, OverflowError, ValueError):
            return None
    if not isinstance(ts, str) or not ts:
        return None
    try:
        d = dt.datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return None
    if d.tzinfo is None:
        d = d.replace(tzinfo=dt.timezone.utc)
    return d.astimezone().date().isoformat()


def _blank() -> dict:
    return {k: 0 for k in TOKEN_KEYS} | {"cost": 0.0, "calls": 0}


def scan() -> dict[str, dict[str, dict]]:
    """Return {day: {model: aggregate}}."""
    pricing = load_pricing()
    days: dict[str, dict[str, dict]] = defaultdict(lambda: defaultdict(_blank))

    # cost split by billing kind: {day: {"sub": float, "api": float}}
    split: dict[str, dict[str, float]] = defaultdict(lambda: {"sub": 0.0, "api": 0.0})

    def add(day, model, u, recorded_cost, provider=""):
        agg = days[day][model]
        for k in TOKEN_KEYS:
            agg[k] += u.get(k, 0) or 0
        cost = recorded_cost if recorded_cost else estimate_cost(model, u, pricing)
        agg["cost"] += cost
        agg["calls"] += 1
        kind = "sub" if is_subscription(provider_of(model, provider)) else "api"
        split[day][kind] += cost

    for path in glob.glob(os.path.join(SESSIONS, "**", "*.jsonl"), recursive=True):
        try:
            fh = open(path, encoding="utf-8")
        except OSError:
            continue
        with fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    o = json.loads(line)
                except ValueError:
                    continue
                if o.get("type") != "message":
                    continue
                m = o.get("message") or {}
                if m.get("role") != "assistant":
                    continue
                u = m.get("usage") or {}
                if not any(u.get(k) for k in TOKEN_KEYS):
                    continue
                day = _local_day(m.get("timestamp"))
                if day is None:
                    day = _local_day(o.get("timestamp"))
                if not day:
                    continue
                cost = u.get("cost")
                if isinstance(cost, dict):
                    cost = cost.get("total", 0)
                add(day, canon_model(m.get("model") or "unknown"), u, cost or 0.0,
                    provider=m.get("provider") or "")

    # subagent / delegate runs -- timestamp from file mtime
    for path in glob.glob(
        os.path.join(SESSIONS, "**", "subagent-artifacts", "*_meta.json"),
        recursive=True,
    ):
        try:
            meta = json.load(open(path, encoding="utf-8"))
        except (OSError, ValueError):
            continue
        u = meta.get("usage") or {}
        if not any(u.get(k) for k in TOKEN_KEYS):
            continue
        day = dt.datetime.fromtimestamp(os.path.getmtime(path)).date().isoformat()
        add(day, canon_model(meta.get("model") or "unknown"), u,
            u.get("cost") or 0.0, provider=meta.get("provider") or "")

    out = {d: dict(models) for d, models in days.items()}
    out["__split__"] = {d: dict(v) for d, v in split.items()}
    return out


# ---------------------------------------------------------------------------
# cache
# ---------------------------------------------------------------------------
def count_prompts(date: str) -> int:
    """User prompts (role=user messages) on a given local day, cached 30s."""
    cache = os.path.join(
        os.environ.get("TMPDIR", "/tmp").rstrip("/"), "pi-usage-prompts.json"
    )
    try:
        st = os.stat(cache)
        if time.time() - st.st_mtime < CACHE_TTL and st.st_mtime >= newest_session_mtime():
            return json.load(open(cache)).get(date, 0)
    except (OSError, ValueError):
        pass
    counts: dict[str, int] = defaultdict(int)
    for path in glob.glob(os.path.join(SESSIONS, "**", "*.jsonl"), recursive=True):
        try:
            fh = open(path, encoding="utf-8")
        except OSError:
            continue
        with fh:
            for line in fh:
                line = line.strip()
                if not line or '"role":"user"' not in line and '"role": "user"' not in line:
                    continue
                try:
                    o = json.loads(line)
                except ValueError:
                    continue
                if o.get("type") != "message":
                    continue
                m = o.get("message") or {}
                if m.get("role") != "user":
                    continue
                day = _local_day(m.get("timestamp")) or _local_day(o.get("timestamp"))
                if day:
                    counts[day] += 1
    try:
        tmp = cache + f".{os.getpid()}"
        json.dump(counts, open(tmp, "w"))
        os.replace(tmp, cache)
    except OSError:
        pass
    return counts.get(date, 0)


# ---------------------------------------------------------------------------
# phoenix (arize) telemetry -- optional; degrades to "" if unreachable
# ---------------------------------------------------------------------------
PHOENIX_BASE = os.environ.get("PHOENIX_URL", "http://localhost:6006")
PHOENIX_CACHE = os.path.join(
    os.environ.get("TMPDIR", "/tmp").rstrip("/"), "pi-usage-phoenix.json"
)
PHOENIX_TTL = 45  # seconds; the scan is multi-page, so cache longer


def _phoenix_projects() -> list[str]:
    import urllib.request
    url = f"{PHOENIX_BASE}/v1/projects"
    with urllib.request.urlopen(url, timeout=3) as r:
        data = json.load(r)
    return [p["name"] for p in data.get("data", []) if p.get("name")]


def phoenix_scan(date: str) -> dict:
    """Aggregate LLM span count, latency, and errors for `date` across projects."""
    import urllib.request
    import urllib.parse
    start = (
        dt.datetime.fromisoformat(date)
        .astimezone()
        .astimezone(dt.timezone.utc)
        .isoformat()
    )
    calls = errs = 0
    lat: list[float] = []
    for proj in _phoenix_projects():
        cursor = None
        for _ in range(30):  # page cap
            q = {"limit": "100", "start_time": start}
            if cursor:
                q["cursor"] = cursor
            url = f"{PHOENIX_BASE}/v1/projects/{urllib.parse.quote(proj)}/spans?" + urllib.parse.urlencode(q)
            try:
                with urllib.request.urlopen(url, timeout=5) as r:
                    d = json.load(r)
            except Exception:
                break
            for s in d.get("data", []):
                if s.get("span_kind") == "LLM":
                    calls += 1
                    try:
                        st = dt.datetime.fromisoformat(s["start_time"])
                        en = dt.datetime.fromisoformat(s["end_time"])
                        lat.append((en - st).total_seconds())
                    except (KeyError, ValueError):
                        pass
                if s.get("status_code") == "ERROR":
                    errs += 1
            cursor = d.get("next_cursor")
            if not cursor:
                break
    lat.sort()

    def pct(q: float) -> float:
        if not lat:
            return 0.0
        return lat[min(len(lat) - 1, int(q * len(lat)))]

    return {"calls": calls, "errs": errs,
            "p50": round(pct(0.5), 1), "p95": round(pct(0.95), 1)}


def phoenix_line(date: str, use_cache: bool = True) -> str:
    stats = None
    if use_cache:
        try:
            st = os.stat(PHOENIX_CACHE)
            if time.time() - st.st_mtime < PHOENIX_TTL:
                blob = json.load(open(PHOENIX_CACHE))
                if blob.get("date") == date:
                    stats = blob.get("stats")
        except (OSError, ValueError):
            pass
    if stats is None:
        try:
            stats = phoenix_scan(date)
        except Exception:
            return ""  # phoenix down -> silent
        try:
            tmp = PHOENIX_CACHE + f".{os.getpid()}"
            json.dump({"date": date, "stats": stats}, open(tmp, "w"))
            os.replace(tmp, PHOENIX_CACHE)
        except OSError:
            pass
    if not stats or not stats.get("calls"):
        return ""
    out = f"\uf0e7{stats['calls']} p50 {stats['p50']:g}s p95 {stats['p95']:g}s"
    if stats.get("errs"):
        out += f"  \u26a0{stats['errs']}"
    return out


def newest_session_mtime() -> float:
    newest = 0.0
    for pat in ("**/*.jsonl", "**/subagent-artifacts/*_meta.json"):
        for p in glob.glob(os.path.join(SESSIONS, pat), recursive=True):
            try:
                newest = max(newest, os.path.getmtime(p))
            except OSError:
                pass
    return newest


def get_aggregate(use_cache: bool = True) -> dict:
    if use_cache:
        try:
            st = os.stat(CACHE_PATH)
            fresh = time.time() - st.st_mtime < CACHE_TTL
            if fresh and st.st_mtime >= newest_session_mtime():
                return json.load(open(CACHE_PATH))
        except (OSError, ValueError):
            pass
    data = scan()
    try:
        tmp = CACHE_PATH + f".{os.getpid()}"
        json.dump(data, open(tmp, "w"))
        os.replace(tmp, CACHE_PATH)
    except OSError:
        pass
    return data


# ---------------------------------------------------------------------------
# formatting
# ---------------------------------------------------------------------------
def human_tokens(n: float) -> str:
    n = float(n)
    for unit, div in (("B", 1e9), ("M", 1e6), ("K", 1e3)):
        if n >= div:
            return f"{n / div:.1f}{unit}".replace(".0", "")
    return str(int(n))


FAMILIES = ("opus", "sonnet", "haiku", "fable", "gemini", "gpt", "llama",
            "qwen", "deepseek", "grok", "mistral", "kimi", "glm", "nemotron",
            "minimax", "laguna")


def canon_model(m: str) -> str:
    """Merge inconsistent prefixes: openrouter/stealth/x == stealth/x."""
    parts = m.split("/")
    return "/".join(parts[-2:]) if len(parts) > 2 else m


def model_family(m: str) -> str:
    tail = canon_model(m).split("/")[-1].lower()
    for kw in FAMILIES:
        if kw in tail:
            return kw
    return tail.replace(":free", "")[:10]


def short_model(m: str) -> str:
    tail = canon_model(m).split("/")[-1]
    return tail.replace("claude-", "").replace(":free", "")[:16]


def day_totals(models: dict) -> dict:
    tot = _blank()
    for agg in models.values():
        for k in TOKEN_KEYS:
            tot[k] += agg[k]
        tot["cost"] += agg["cost"]
        tot["calls"] += agg["calls"]
    tot["tokens"] = sum(tot[k] for k in TOKEN_KEYS)
    return tot


def pct_delta(cur: float, prev: float) -> str:
    if not prev:
        return "—" if not cur else "new"
    d = (cur - prev) / prev * 100
    arrow = "↑" if d >= 0 else "↓"
    return f"{arrow}{abs(d):.0f}%"


def oneline(agg: dict, date: str) -> str:
    models = agg.get(date, {})
    if not models:
        return "󰚩 pi: idle today"
    t = day_totals(models)
    prev = date_shift(date, -1)
    delta = pct_delta(t["tokens"], day_totals(agg.get(prev, {}))["tokens"] if agg.get(prev) else 0)
    top = sorted(models.items(), key=lambda kv: -sum(kv[1][k] for k in TOKEN_KEYS))
    names = "·".join(dict.fromkeys(model_family(m) for m, _ in top[:3]))
    cost = f"${t['cost']:.2f}" if t["cost"] >= 0.01 else "$0"
    return (
        f"󰚩 {human_tokens(t['tokens'])} tok  "
        f"{human_tokens(t['output'])}↓out  {cost}  {delta}  {names}"
    )


def dayline(agg: dict, date: str) -> str:
    """Day total only: tokens + cost, no model names."""
    models = agg.get(date, {})
    if not models:
        return "\u2211 idle today"
    t = day_totals(models)
    prompts = count_prompts(date)
    sp = (agg.get("__split__") or {}).get(date, {})
    sub, api = sp.get("sub", 0.0), sp.get("api", 0.0)

    def money(x: float) -> str:
        return f"${x:.2f}" if x >= 0.01 else "$0"

    # sub = API-equivalent value covered by subscription; api = real metered $
    if sub and api:
        cost = f"{money(sub)} sub + {money(api)} api"
    elif sub:
        cost = f"{money(sub)} sub"
    else:
        cost = f"{money(api)} api"
    return (
        f"\u2211 {human_tokens(t['tokens'])} tok  {cost}  "
        f"\u00b7 {prompts} prompt{'s' if prompts != 1 else ''}"
    )


def leftstatus(agg: dict, date: str, use_cache: bool = True) -> str:
    """Composed wezterm left status: day tokens/cost/prompts + phoenix telemetry.
    Intended to be run in the background writing to a text file that the UI
    reads instantly; never call this synchronously from the render loop."""
    day = dayline(agg, date)
    ph = phoenix_line(date, use_cache=use_cache)
    return f"{day}   \u2502 {ph}" if ph else day


def date_shift(date: str, days: int) -> str:
    return (dt.date.fromisoformat(date) + dt.timedelta(days=days)).isoformat()


def scan_session(path: str) -> dict:
    """Aggregate a single session .jsonl: tokens, cost, current model, thinking."""
    pricing = load_pricing()
    agg = _blank()
    agg["tokens"] = 0
    model = None
    thinking = None
    try:
        fh = open(path, encoding="utf-8")
    except OSError:
        return agg | {"model": None, "thinking": None}
    with fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                o = json.loads(line)
            except ValueError:
                continue
            typ = o.get("type")
            if typ == "model_change":
                mid = o.get("modelId")
                if mid:
                    model = mid
                continue
            if typ == "thinking_level_change":
                thinking = o.get("thinkingLevel") or thinking
                continue
            if typ != "message":
                continue
            m = o.get("message") or {}
            if m.get("role") != "assistant":
                continue
            if m.get("model"):
                model = m["model"]
            u = m.get("usage") or {}
            if not any(u.get(k) for k in TOKEN_KEYS):
                continue
            for k in TOKEN_KEYS:
                agg[k] += u.get(k, 0) or 0
            cost = u.get("cost")
            if isinstance(cost, dict):
                cost = cost.get("total", 0)
            agg["cost"] += cost or estimate_cost(model or "unknown", u, pricing)
            agg["calls"] += 1
    agg["tokens"] = sum(agg[k] for k in TOKEN_KEYS)
    return agg | {"model": model, "thinking": thinking}


def latest_session_for_cwd(cwd: str) -> str | None:
    """Newest session .jsonl whose `session` record cwd matches."""
    cwd = os.path.realpath(os.path.expanduser(cwd))
    best: tuple[float, str] | None = None
    for path in glob.glob(os.path.join(SESSIONS, "*", "*.jsonl")):
        try:
            with open(path, encoding="utf-8") as fh:
                first = fh.readline()
        except OSError:
            continue
        try:
            o = json.loads(first)
        except ValueError:
            continue
        if o.get("type") != "session":
            continue
        sc = o.get("cwd")
        if not sc or os.path.realpath(os.path.expanduser(sc)) != cwd:
            continue
        try:
            mt = os.path.getmtime(path)
        except OSError:
            continue
        if best is None or mt > best[0]:
            best = (mt, path)
    return best[1] if best else None


def window_oneline(cwd: str) -> str:
    path = latest_session_for_cwd(cwd)
    if not path:
        return "\u29c9 pi: no session"
    s = scan_session(path)
    if not s.get("model") and not s["tokens"]:
        return "\u29c9 pi: idle"
    name = short_model(s.get("model") or "?")
    think = (s.get("thinking") or "").lower()
    think_abbr = {"minimal": "min", "low": "lo", "medium": "med",
                  "high": "hi", "max": "max"}.get(think, "")
    think_tag = f" \u00b7{think_abbr}" if think_abbr else ""
    cost = f"${s['cost']:.2f}" if s["cost"] >= 0.01 else "$0"
    return (
        f"\u29c9 {name}{think_tag}  "
        f"{human_tokens(s['tokens'])} tok  {cost}"
    )


def full_report(agg: dict, date: str, span: int) -> str:
    out: list[str] = []
    dates = [date_shift(date, -i) for i in range(span)][::-1]
    week = [d for d in (date_shift(date, -i) for i in range(1, 8)) if agg.get(d)]
    week_avg = (
        sum(day_totals(agg[d])["tokens"] for d in week) / len(week) if week else 0
    )

    for d in dates:
        models = agg.get(d, {})
        if not models and d != date:
            continue
        t = day_totals(models)
        prev = day_totals(agg.get(date_shift(d, -1), {})) if agg.get(date_shift(d, -1)) else None
        head = f"  {d}   {human_tokens(t['tokens'])} tok   ${t['cost']:.2f}   {t['calls']} calls"
        if prev:
            head += f"   {pct_delta(t['tokens'], prev['tokens'])} vs prev day"
        if d == date and week_avg:
            head += f"   {pct_delta(t['tokens'], week_avg)} vs 7d avg"
        out.append(head)
        if d == date:
            rows = sorted(
                models.items(),
                key=lambda kv: -sum(kv[1][k] for k in TOKEN_KEYS),
            )
            for model, a in rows:
                tok = sum(a[k] for k in TOKEN_KEYS)
                cache = a["cacheRead"] + a["cacheWrite"]
                out.append(
                    f"      {short_model(model):<16} "
                    f"{human_tokens(tok):>7} tok  "
                    f"in {human_tokens(a['input']):>6}  "
                    f"out {human_tokens(a['output']):>6}  "
                    f"cache {human_tokens(cache):>6}  "
                    f"${a['cost']:.2f}  ({a['calls']})"
                )
    if not out:
        return "no pi usage recorded"
    return "\n".join(out)


# ---------------------------------------------------------------------------
def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--oneline", action="store_true")
    ap.add_argument("--dayline", action="store_true",
                    help="day total only: tokens + cost + prompt count")
    ap.add_argument("--phoenix", action="store_true",
                    help="phoenix/arize telemetry: LLM calls + latency + errors")
    ap.add_argument("--leftstatus", action="store_true",
                    help="composed wezterm left status (dayline + phoenix); "
                         "run in background, read its output file from the UI")
    ap.add_argument("--window", metavar="CWD",
                    help="per-window line: model + tokens/cost for the latest "
                         "pi session in CWD")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--date", default=dt.date.today().isoformat())
    ap.add_argument("--days", type=int, default=1)
    ap.add_argument("--no-cache", action="store_true")
    args = ap.parse_args()

    if not os.path.isdir(SESSIONS):
        msg = "󰚩 pi: no sessions" if (args.oneline or args.window) else "pi sessions dir not found"
        print(msg)
        return 0

    if args.window:
        print(window_oneline(args.window))
        return 0

    if args.dayline:
        print(dayline(get_aggregate(use_cache=not args.no_cache), args.date))
        return 0

    if args.phoenix:
        print(phoenix_line(args.date, use_cache=not args.no_cache))
        return 0

    if args.leftstatus:
        print(leftstatus(get_aggregate(use_cache=not args.no_cache),
                         args.date, use_cache=not args.no_cache))
        return 0

    agg = get_aggregate(use_cache=not args.no_cache)

    if args.json:
        print(json.dumps(agg, indent=2))
    elif args.oneline:
        print(oneline(agg, args.date))
    else:
        print(full_report(agg, args.date, max(1, args.days)))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
